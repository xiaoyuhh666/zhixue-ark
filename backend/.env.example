# =====================================================
# 智学方舟 后端环境变量模板
# 复制为 .env 后填入真实密钥；未配置密钥的供应商在平台中显示「未接入」
# =====================================================

# ---- LLM 供应商（OpenAI 兼容协议，可切换）----
# 默认供应商：deepseek | qwen | glm；FALLBACK_PROVIDER 为免费兜底（所选模型未接入时自动切换）
LLM_PROVIDER=deepseek
FALLBACK_PROVIDER=glm

# DeepSeek（主力）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 通义千问（阿里云百炼，新用户 100 万 tokens 赠金 90 天）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 智谱 GLM（永久免费档，兜底首选）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# ---- 应用 ----
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/app.db

# ---- Turso 云数据库（可选，留空则全部回落本地 SQLite 文件）----
# 配置后：业务数据 + 知识库向量持久化到 Turso，Render 等临时盘平台重启不再丢
# 建库 region 例如东京（aws-ap-northeast-1）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
